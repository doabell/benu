{
    "name": "benu",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "bun run configure && vite build",
        "preview": "vite preview",
        "start": "wrangler dev",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "prepare": "svelte-kit sync",
        "configure": "bun scripts/configure.ts",
        "deploy": "bun scripts/deploy.ts",
        "deploy:preview": "wrangler deploy --env preview",
        "refresh:local": "bun scripts/refresh-local.ts",
        "test:browser": "playwright test",
        "test:dev": "playwright test --config playwright.dev.config.ts",
        "verify": "bun run check && bun run lint && bun run test && bun run build"
    },
    "dependencies": {
        "@fontsource/roboto": "^5.3.0",
        "@lucide/svelte": "^1.25.0",
        "@sveltejs/kit": "^2.70.1",
        "svelte": "^5.56.7",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@cloudflare/workers-types": "^5.20261117.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.1",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.1.1",
        "@vite-pwa/sveltekit": "^1.1.0",
        "eslint": "^10.7.0",
        "eslint-plugin-svelte": "^3.22.0",
        "globals": "^17.7.0",
        "jsonc-parser": "^3.3.1",
        "miniflare": "^4.20260730.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte-check": "^4.7.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "workbox-broadcast-update": "^7.4.1",
        "workbox-core": "^7.4.1",
        "workbox-expiration": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1",
        "wrangler": "^4.163.0"
    },
    "packageManager": "bun@1.4.4"
}
